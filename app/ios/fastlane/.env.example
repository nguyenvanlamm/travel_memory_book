# Fastlane Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# Apple Developer Team ID (10-character string)
TEAM_ID=YOUR_TEAM_ID

# Apple ID for App Store Connect
APPLE_ID=your-apple-id@example.com

# App Store Connect API Key (for automated uploads)
# Download from App Store Connect > Users and Access > Keys
APP_STORE_CONNECT_API_KEY_PATH=./fastlane/authkey.p8
APP_STORE_CONNECT_API_KEY_ID=YOUR_KEY_ID
APP_STORE_CONNECT_API_ISSUER_ID=YOUR_ISSUER_ID

# Build version (optional, auto-generated from git commits if not set)
# BUILD_NUMBER=1
# VERSION_NUMBER=1.0.0

# Match (certificates repo)
MATCH_GIT_URL=https://github.com/your-org/certificates.git
MATCH_PASSWORD=your-match-password

# GitHub Actions
GITHUB_TOKEN=your-github-token

# Slack (optional)
# SLACK_URL=https://hooks.slack.com/services/xxx